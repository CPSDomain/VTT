{
  "appId": "app.tabletop.player",
  "productName": "Tabletop Player",
  "extraMetadata": {
    "main": "apps/player/main.js",
    "name": "tabletop-player"
  },
  "directories": {
    "output": "dist/player",
    "buildResources": "build"
  },
  "files": [
    "apps/player/**",
    "apps/shared/**",
    "build/icon.png",
    "package.json",
    "!**/*.map"
  ],
  "asar": true,
  "afterPack": "build/afterPack.js",
  "compression": "normal",
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "zip",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "build/icon.ico",
    "signAndEditExecutable": false
  },
  "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Tabletop Player",
    "installerIcon": "build/icon.ico",
    "uninstallerIcon": "build/icon.ico",
    "deleteAppDataOnUninstall": false,
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "runAfterFinish": true
  }
}